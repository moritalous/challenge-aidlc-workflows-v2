# Task-app API environment. NO real secrets here.
# DynamoDB table name (injected into the Lambda as TABLE_NAME).
TABLE_NAME=
# AWS region. CloudFront ACM requires us-east-1 for the cert; the app deploys here.
AWS_REGION=us-east-1
# Allowed CORS origin for the API (defaults to '*' in the skeleton).
CORS_ORIGIN=*
